{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist/renderer",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/*"],
      "@shared/*": ["../../packages/shared/src/*"],
      "@appname/shared": ["../../packages/shared/src"]
    }
  },
  "include": ["src/renderer/**/*", "../../packages/shared/src/**/*"]
}
